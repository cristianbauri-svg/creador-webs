{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "straton-audio",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCESS_TEAM_DOMAIN": "divine-band-3e2f",
    "CF_ACCESS_AUD": "1ea2c0985c3902126727928ac8bf39356f04b64a07958836b2592075decbfbf1"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "STRATON_DB",
      "database_name": "straton-db",
      "database_id": "9cd6a924-c4ec-4fe3-84d8-63aeec1b69b9"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STRATON_KV",
      "id": "427e7f161e08458fa8ee22a41ccb0d0a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STRATON_BUCKET",
      "bucket_name": "straton-bucket"
    }
  ]
}
