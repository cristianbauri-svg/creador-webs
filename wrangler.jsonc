{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "straton-audio",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "STRATON_DB",
      "database_name": "straton-db",
      "database_id": "9cd6a924-c4ec-4fe3-84d8-63aeec1b69b9"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STRATON_KV",
      "id": "427e7f161e08458fa8ee22a41ccb0d0a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STRATON_BUCKET",
      "bucket_name": "straton-bucket"
    }
  ]
}
