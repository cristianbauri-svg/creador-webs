{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "straton-audio",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // TODO antes de desplegar: reemplazar con los valores reales de la app
    // de Cloudflare Access que protege /admin/* (Zero Trust > Access >
    // Applications > stratonaudio.com.co). No pude obtenerlos por API: el
    // token de Vault no tiene permiso "Access: Apps and Policies Read".
    "CF_ACCESS_TEAM_DOMAIN": "REEMPLAZAR_TEAM_DOMAIN",
    "CF_ACCESS_AUD": "REEMPLAZAR_AUD"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "STRATON_DB",
      "database_name": "straton-db",
      "database_id": "9cd6a924-c4ec-4fe3-84d8-63aeec1b69b9"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STRATON_KV",
      "id": "427e7f161e08458fa8ee22a41ccb0d0a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STRATON_BUCKET",
      "bucket_name": "straton-bucket"
    }
  ]
}
